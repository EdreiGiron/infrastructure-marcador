server {
  server_name proyectoede.lat www.proyectoede.lat;

  # FRONTEND (Angular) en host:4200
  location / {
    proxy_pass http://127.0.0.1:4200;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # try_files $uri $uri/ /index.html;  # descomenta si necesitas fallback SPA
  }

  # BACKEND (API .NET) en host:5002
  location /api/ {
    proxy_pass http://127.0.0.1:5002;
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        "upgrade";
  }

  # SIGNALR (WebSocket) /hub/score
  location /hub/ {
    proxy_pass http://127.0.0.1:5002;
    proxy_http_version 1.1;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        "upgrade";
    proxy_set_header Host              $host;
    proxy_read_timeout 3600;
    proxy_send_timeout 3600;
  }
  # Parche: aceptar /api/hub/* desde el front y redirigir al hub real
  location /api/hub/ {
    rewrite ^/api/hub/(.*)$ /hub/$1 break;
    proxy_pass http://127.0.0.1:5002;   # sin slash final
    proxy_http_version 1.1;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        "upgrade";
    proxy_set_header Host              $host;
    proxy_read_timeout 3600;
    proxy_send_timeout 3600;
  }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/proyectoede.lat/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/proyectoede.lat/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot


}
server {
    if ($host = www.proyectoede.lat) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    if ($host = proyectoede.lat) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


  listen 80;
  server_name proyectoede.lat www.proyectoede.lat;
    return 404; # managed by Certbot




}